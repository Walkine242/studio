
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Basic rules for the Dual prototype.
    // Updated to ensure all collections are accessible for prototype testing.
    
    match /race-results/{resultId} {
      allow read, write: if true;
    }
    
    match /awards/{awardId} {
      allow read, write: if true;
    }
    
    match /parties/{partyId} {
      allow read, write: if true;
    }

    match /meets/{meetId} {
      // Only the specific owner ID can create test meets
      allow read: if true;
      allow write: if request.auth != null || true; // In prototype we allow for easy testing but we'll gate it in UI
    }
  }
}
